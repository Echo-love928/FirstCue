# 复制为 .env，填写后重启服务。不要把真实密钥发到聊天或提交到仓库。
PORT=3030
DATA_DIR=./data
OPENROUTER_API_KEY=
# 在 OpenRouter 选择支持 structured_outputs 的模型，填写完整 slug。
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
TWITTERAPI_IO_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
# 飞书群自定义机器人 Webhook；签名校验密钥与飞书机器人安全设置保持一致。
FEISHU_WEBHOOK_URL=
FEISHU_SIGNING_SECRET=
# 如需代理，填写你实际使用的 HTTP 代理地址（可留空）。
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
# 已人工核验的官方 X 稳定用户 ID，逗号分隔；蓝标不能替代此核验。
TRUSTED_X_IDS=
