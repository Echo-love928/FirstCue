# Copy ONLY this skill's example to this skill's .env. Never copy project secrets.
# The CLI only loads this directory's .env (or --env-file), never the working directory's.
TWITTERAPI_IO_KEY=
HTTPS_PROXY=
HTTP_PROXY=
# Optional notification channels. Collection never sends messages automatically.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
FEISHU_WEBHOOK_URL=
FEISHU_SIGNING_SECRET=
